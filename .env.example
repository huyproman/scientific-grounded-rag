# ==============================================================================
# Scientific Grounded RAG Environment Configuration Template
# Copy to .env and adjust variables as appropriate for your local deployment.
# ==============================================================================

# Vector Database (Qdrant)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6335
QDRANT_GRPC_PORT=6336
QDRANT_COLLECTION=scifact_chunks
QDRANT_TIMEOUT=10.0

# Retrieval Engine Configuration
# DENSE_BACKEND options: "qdrant" (uses local Qdrant container) or "file" (offline local index)
DENSE_BACKEND=qdrant
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
MODEL_DEVICE=cpu
RRF_K=60
INITIAL_TOP_K=5
EXPANDED_TOP_K=15

# LLM Gateway Configuration (OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:8000
LLM_API_KEY=
LLM_MODEL=ag/gemini-3.8-flash-high
REQUEST_TIMEOUT=60
MAX_CONCURRENT_GENERATIONS=3
# Remote LLM calls are blocked unless this is true; your provider may bill per request.
PAID_INFERENCE_AUTHORIZED=false

# Serving Configuration (FastAPI)
API_HOST=127.0.0.1
API_PORT=8008
LOG_LEVEL=INFO
LOG_FORMAT=json

# Scientific Verification Settings
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-xsmall
NLI_THRESHOLD=0.60
CANONICAL_SENTENCE_PROVENANCE=true
